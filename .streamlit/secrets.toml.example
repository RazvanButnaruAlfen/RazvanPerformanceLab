# Add these values in Streamlit Community Cloud:
# App -> Settings -> Secrets
#
# Use the Supabase Project URL and the public anon/publishable key.
# Never put the service_role key in Streamlit client-facing app secrets.

[supabase]
url = "https://YOUR_PROJECT.supabase.co"
key = "YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
